#!/usr/bin/env bash
set -euo pipefail

# Native PostgreSQL development cluster; no global service configuration is changed.
# Default macOS distribution: Postgres.app 2.9.6 / PostgreSQL 17.11.
# https://postgresapp.com/downloads.html
# https://github.com/PostgresApp/PostgresApp/releases/tag/v2.9.6
# Postgres-2.9.6-17.dmg SHA-256:
# b38bb00b8c8702a568270aab85995c550f7f93d1503b818efdc5ff9a519b7168
# Set ORDERFLOW_PG_BIN to a compatible PostgreSQL 17 bin directory on other machines.

project_root="$(cd "$(dirname "$0")/.." && pwd)"
runtime_dir="$project_root/.tools/postgres-runtime"
data_dir="$runtime_dir/data"
socket_dir="$runtime_dir/socket"
password_file="$runtime_dir/password"
log_file="$runtime_dir/postgres.log"
pg_bin="${ORDERFLOW_PG_BIN:-$project_root/.tools/postgres/Postgres.app/Contents/Versions/17/bin}"
port=54329
db_user=orderflow

fail() { printf '%s\n' "$*" >&2; exit 1; }

require_binaries() {
  for binary in initdb pg_ctl psql createdb pg_isready; do
    [[ -x "$pg_bin/$binary" ]] || fail "Missing $pg_bin/$binary. Install PostgreSQL 17 locally, or set ORDERFLOW_PG_BIN."
  done
}

is_running() {
  [[ -f "$data_dir/PG_VERSION" ]] && "$pg_bin/pg_ctl" -D "$data_dir" status >/dev/null 2>&1
}

connect() {
  PGPASSFILE=/dev/null PGPASSWORD="$(cat "$password_file")" PGCONNECT_TIMEOUT=5 \
    "$pg_bin/psql" -X --host=127.0.0.1 --port="$port" --username="$db_user" --no-password --set=ON_ERROR_STOP=1 "$@"
}

write_config() {
  local db_name config_file
  for db_name in orderflow orderflow_test; do
    if [[ "$db_name" == orderflow ]]; then
      config_file="$project_root/.tools/database.properties"
    else
      config_file="$project_root/.tools/test-database.properties"
    fi
    {
      printf '# Generated by scripts/db; ignored by Git. Local development only.\n'
      printf 'spring.datasource.url=jdbc:postgresql://127.0.0.1:%s/%s\n' "$port" "$db_name"
      printf 'spring.datasource.username=%s\n' "$db_user"
      printf 'spring.datasource.password=%s\n' "$(cat "$password_file")"
    } > "$config_file"
    chmod 600 "$config_file"
  done
}

initialize() {
  umask 077
  mkdir -p "$runtime_dir" "$socket_dir"
  if [[ ! -e "$password_file" ]]; then
    [[ ! -e "$data_dir/PG_VERSION" ]] || fail "Existing cluster has no local password file. Restore it rather than resetting credentials."
    openssl rand -hex 24 > "$password_file"
  fi
  chmod 700 "$runtime_dir" "$socket_dir"
  chmod 600 "$password_file"
  if [[ ! -f "$data_dir/PG_VERSION" ]]; then
    "$pg_bin/initdb" -D "$data_dir" --username="$db_user" --pwfile="$password_file" \
      --auth-local=scram-sha-256 --auth-host=scram-sha-256 --encoding=UTF8 --locale=C
    # TCP binds only to loopback. The private socket directory belongs to this project.
    {
      printf '\n# Orderflow local teaching database\n'
      printf "listen_addresses = '127.0.0.1'\n"
      printf 'port = %s\n' "$port"
      printf "unix_socket_directories = '%s'\n" "${socket_dir//\'/\'\'}"
    } >> "$data_dir/postgresql.conf"
  fi
}

start() {
  initialize
  if ! is_running; then
    "$pg_bin/pg_ctl" -D "$data_dir" -l "$log_file" -w -t 30 start
  fi
  # Connecting with the cluster-specific password confirms this is our instance.
  for db_name in orderflow orderflow_test; do
    if [[ "$(connect --dbname=postgres --tuples-only --no-align --command="SELECT 1 FROM pg_database WHERE datname = '$db_name'")" != 1 ]]; then
      PGPASSFILE=/dev/null PGPASSWORD="$(cat "$password_file")" PGCONNECT_TIMEOUT=5 \
        "$pg_bin/createdb" --host=127.0.0.1 --port="$port" --username="$db_user" --no-password "$db_name"
    fi
  done
  write_config
  printf 'PostgreSQL ready at 127.0.0.1:%s (orderflow and orderflow_test).\n' "$port"
}

stop() {
  if is_running; then
    "$pg_bin/pg_ctl" -D "$data_dir" -w -t 30 -m fast stop
  else
    printf 'This project database is already stopped.\n'
  fi
}

status() {
  if is_running; then
    "$pg_bin/pg_ctl" -D "$data_dir" status
    connect --dbname=postgres --tuples-only --no-align --command='SELECT version();'
  else
    printf 'This project database is stopped.\n'
    exit 1
  fi
}

require_binaries
case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  psql)
    shift
    [[ -f "$password_file" ]] || fail 'Run ./scripts/db start first.'
    # Example: ./scripts/db psql --dbname=orderflow_test --command='SELECT 1'
    connect --dbname=orderflow "$@"
    ;;
  *) fail 'Usage: ./scripts/db {start|stop|status|psql [psql arguments]}' ;;
esac
