#!/bin/sh
# Select Java 21 for this project without changing your shell's default JDK.
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$PROJECT_DIR/.tools/java21/Contents/Home/bin/java" ]; then
    JAVA_HOME="$PROJECT_DIR/.tools/java21/Contents/Home"
elif [ -z "${JAVA_HOME:-}" ] && [ -x /usr/libexec/java_home ]; then
    JAVA_HOME=$(/usr/libexec/java_home -v 21 2>/dev/null || true)
fi
if [ -n "${JAVA_HOME:-}" ]; then
    export JAVA_HOME
    PATH="$JAVA_HOME/bin:$PATH"
    export PATH
fi
if ! java -version 2>&1 | grep -Eq '^(openjdk|java) version "21[.\"]'; then
    echo 'Java 21 is required. Set JAVA_HOME to your JDK 21 installation.' >&2
    exit 1
fi
MAVEN_USER_HOME="$PROJECT_DIR/.tools/maven"
export MAVEN_USER_HOME
cd "$PROJECT_DIR"
exec "$PROJECT_DIR/mvnw" "-Dmaven.repo.local=$PROJECT_DIR/.tools/m2" "$@"
